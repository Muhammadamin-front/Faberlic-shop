# Shu faylni ".env" deb nusxalang va qiymatlarni to'ldiring.
# Bot tokeni — Telegramda @BotFather → /newbot
BOT_TOKEN=123456789:AA...
# Buyurtmalar keladigan chat ID. O'zingizniki: @userinfobot ga /start yozing.
# Guruhga kelsin desangiz, botni guruhga qo'shing; guruh ID si -100 bilan boshlanadi.
ADMIN_CHAT_ID=123456789
PORT=8000
